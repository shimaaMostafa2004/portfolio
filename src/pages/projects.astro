---
import HomeLikeHeader from '../components/HomeLikeHeader.astro';
import HomeLikeFooter from '../components/HomeLikeFooter.astro';
---

<!DOCTYPE html>
<html lang="ar" dir="rtl" prefix="og: https://ogp.me/ns#">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>معرض الأعمال | عبدالرحمن طاهر</title>
  <meta name="description" content="استعرض مشاريع عبدالرحمن طاهر في الأنظمة الخلفية ومنتجات التشغيل وتطبيقات الموبايل مع وصف مختصر وتقنيات التنفيذ."/>
  <meta name="robots" content="index, follow, max-image-preview:large"/>
  <link rel="canonical" href="https://abdotaher.me/projects/"/>
  <meta property="og:type" content="website"/>
  <meta property="og:title" content="معرض الأعمال | عبدالرحمن طاهر"/>
  <meta property="og:description" content="كل المشاريع والتطبيقات في صفحة واحدة مع عرض واضح للتقنيات والنتائج."/>
  <meta property="og:url" content="https://abdotaher.me/projects/"/>
  <meta property="og:image" content="https://abdotaher.me/image.png"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content="معرض الأعمال | عبدالرحمن طاهر"/>
  <meta name="twitter:description" content="كل المشاريع والتطبيقات في صفحة واحدة."/>
  <meta name="twitter:image" content="https://abdotaher.me/image.png"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&family=Space+Grotesk:wght@400;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet"/>
  <script src="/site-i18n.js" defer></script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <link rel="icon" type="image/png" sizes="32x32" href="/image.png"/>
  <link rel="apple-touch-icon" href="/image.png"/>
  <style>
    .projects-wrap {
      max-width: 1160px;
      margin: 0 auto;
      padding: 1.25rem;
    }

    .projects-hero {
      background: linear-gradient(135deg, rgba(155, 240, 255, 0.08), rgba(30, 25, 51, 0.96) 45%);
      border: 1px solid rgba(112, 213, 230, 0.18);
      border-radius: 22px;
      padding: 1.5rem;
      box-shadow: 0 18px 48px rgba(0, 0, 0, 0.22);
    }

    .projects-kicker {
      color: #8ff700;
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      font-weight: 800;
      text-transform: uppercase;
      margin: 0;
    }

    .projects-hero h1 {
      margin: 0.45rem 0 0;
      font-size: clamp(1.7rem, 4vw, 2.5rem);
      line-height: 1.3;
      color: #e7deff;
    }

    .projects-hero p {
      margin: 0.65rem 0 0;
      color: rgba(231, 222, 255, 0.78);
      max-width: 74ch;
    }

    .projects-grid {
      margin-top: 1.2rem;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.15rem;
    }

    .projects-summary {
      margin-top: 0.9rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
    }

    .summary-pill {
      border: 1px solid rgba(112, 213, 230, 0.22);
      background: rgba(255, 255, 255, 0.03);
      color: rgba(231, 222, 255, 0.86);
      border-radius: 999px;
      padding: 0.42rem 0.72rem;
      font-size: 0.66rem;
      font-weight: 800;
      letter-spacing: 0.11em;
      text-transform: uppercase;
    }

    .projects-section-title {
      margin: 1.15rem 0 0;
      color: rgba(231, 222, 255, 0.92);
      font-size: 0.9rem;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      font-weight: 800;
    }

    .project-card {
      background: linear-gradient(180deg, rgba(30, 25, 51, 0.96), rgba(13, 11, 26, 0.96));
      border: 1px solid rgba(112, 213, 230, 0.2);
      border-radius: 20px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      min-height: 100%;
      transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
    }

    .project-card:hover {
      transform: translateY(-4px);
      border-color: rgba(155, 240, 255, 0.44);
      box-shadow: 0 24px 56px rgba(0, 0, 0, 0.32);
    }

    .project-card.featured {
      border-color: rgba(143, 247, 0, 0.32);
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.3), inset 0 0 0 1px rgba(143, 247, 0, 0.12);
    }

    .project-image {
      aspect-ratio: 16 / 9;
      background: rgba(255, 255, 255, 0.03);
      border-bottom: 1px solid rgba(112, 213, 230, 0.14);
      overflow: hidden;
    }

    .project-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .project-image.is-placeholder {
      display: grid;
      place-items: center;
      color: rgba(231, 222, 255, 0.64);
      font-size: 0.74rem;
      font-weight: 800;
      letter-spacing: 0.09em;
      text-transform: uppercase;
    }

    .project-body {
      padding: 1rem;
      display: flex;
      flex-direction: column;
      flex: 1;
      gap: 0.68rem;
      min-width: 0;
    }

    .project-title {
      margin: 0;
      color: #e7deff;
      font-size: 1.03rem;
      line-height: 1.4;
      font-weight: 800;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .project-desc {
      margin: 0;
      color: rgba(231, 222, 255, 0.76);
      font-size: 0.88rem;
      line-height: 1.72;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .project-stack {
      margin-top: auto;
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    .project-tag {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      border: 1px solid rgba(155, 240, 255, 0.24);
      background: rgba(255, 255, 255, 0.03);
      color: #9bf0ff;
      padding: 0.22rem 0.56rem;
      font-size: 0.63rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      max-width: 100%;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .project-actions {
      margin-top: 0.1rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
    }

    .project-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.28rem;
      min-height: 44px;
      padding: 0.58rem 0.8rem;
      border-radius: 0.72rem;
      text-decoration: none;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    .project-action.primary {
      background: linear-gradient(135deg, #9bf0ff, #7de6ff);
      color: #052129;
      border: 1px solid transparent;
    }

    .project-action.primary:hover {
      background: linear-gradient(135deg, #bcf6ff, #8be9fb);
    }

    .project-action.ghost {
      color: #9bf0ff;
      border: 1px solid rgba(155, 240, 255, 0.24);
      background: rgba(255, 255, 255, 0.02);
    }

    .project-action.ghost:hover {
      color: #d8fbff;
      border-color: rgba(155, 240, 255, 0.42);
      background: rgba(155, 240, 255, 0.08);
    }

    .project-action-disabled {
      color: rgba(231, 222, 255, 0.54);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .projects-state {
      margin-top: 1rem;
      background: rgba(255, 255, 255, 0.03);
      border: 1px dashed rgba(112, 213, 230, 0.22);
      border-radius: 14px;
      padding: 0.95rem 1rem;
      color: rgba(231, 222, 255, 0.74);
      font-size: 0.9rem;
    }

    .projects-state.error {
      border-color: rgba(255, 122, 122, 0.42);
      color: #ffd1d1;
    }

    @media (max-width: 1024px) {
      .projects-wrap {
        padding: 1rem;
      }

      .projects-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 760px) {
      .projects-wrap { padding: 1rem; }

      .projects-hero,
      .project-body {
        padding: 0.95rem;
      }

      .projects-grid {
        grid-template-columns: 1fr;
      }
      .project-actions {
        flex-direction: column;
      }
      .project-action {
        width: 100%;
      }
    }

    @media (max-width: 520px) {
      .projects-hero h1 {
        font-size: clamp(1.45rem, 8vw, 1.95rem);
      }

      .project-title {
        font-size: 0.95rem;
      }

      .project-desc {
        font-size: 0.84rem;
      }
    }
  </style>
</head>
<body>
  <HomeLikeHeader />
  <main class="home-like-main">
    <div class="projects-wrap">
      <section class="projects-hero" aria-labelledby="projects-heading">
        <p class="projects-kicker" data-i18n="projects.kicker">Portfolio</p>
        <h1 id="projects-heading" data-i18n="projects.hero_title">معرض أعمال يوضح التنفيذ الفعلي للمشاريع</h1>
        <p data-i18n="projects.hero_desc">صفحة تجمع المشاريع في مكان واحد مع وصف مختصر للتقنيات وسياق الاستخدام حتى ترى نوع الأعمال التي تم تنفيذها فعليًا.</p>
        <div id="projects-summary" class="projects-summary" aria-live="polite"></div>
      </section>

      <div id="projects-state" class="projects-state" role="status" aria-live="polite" data-i18n="projects.loading">جاري تحميل المشاريع...</div>
      <h2 class="projects-section-title" data-i18n="projects.section_title">Latest Projects</h2>
      <section id="projects-grid" class="projects-grid" role="list" data-i18n-attr="aria-label:projects.gallery_aria" aria-label="Projects gallery"></section>
    </div>

    <script>
      function escapeHtml(value) {
        return String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/\"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function normalizeProject(project) {
        return {
          name: project.name || project.title || project.project || '',
          image: project.image || project.image_url || project.img || '',
          altAr: project.altAr || project.alt_ar || project.altar || '',
          altEn: project.altEn || project.alt_en || project.alten || '',
          descAr: project.descAr || project.desc_ar || project.description_ar || '',
          descEn: project.descEn || project.desc_en || project.description_en || '',
          tags: project.tags || project.stack || '',
          link: project.link || project.url || project.href || ''
        };
      }

      function splitTags(value) {
        return String(value || '')
          .split(/[|,\/•]/g)
          .map((item) => item.trim())
          .filter(Boolean);
      }

      function renderSummary(projects, lang) {
        const summary = document.getElementById('projects-summary');
        if (!summary) return;

        const withLinks = projects.filter((item) => item.link).length;
        const uniqueTech = new Set(projects.flatMap((item) => splitTags(item.tags))).size;

        const projectsLabel = window.siteI18n?.t?.('projects.summary_projects', lang === 'en' ? 'Projects' : 'مشروع')
          || (lang === 'en' ? 'Projects' : 'مشروع');
        const linksLabel = window.siteI18n?.t?.('projects.summary_links', lang === 'en' ? 'Live Links' : 'روابط مباشرة')
          || (lang === 'en' ? 'Live Links' : 'روابط مباشرة');
        const stackLabel = window.siteI18n?.t?.('projects.summary_tech', lang === 'en' ? 'Technologies' : 'تقنيات')
          || (lang === 'en' ? 'Technologies' : 'تقنيات');

        summary.innerHTML = [
          `<span class="summary-pill">${projects.length} ${projectsLabel}</span>`,
          `<span class="summary-pill">${withLinks} ${linksLabel}</span>`,
          `<span class="summary-pill">${uniqueTech} ${stackLabel}</span>`
        ].join('');
      }

      function renderProjects(projects) {
        const grid = document.getElementById('projects-grid');
        const state = document.getElementById('projects-state');
        if (!grid || !state) return;

        const lang = window.siteI18n?.getLang?.() || (document.body.classList.contains('lang-en') ? 'en' : 'ar');
        const valid = projects.filter((item) => item && item.name);

        if (!valid.length) {
          state.classList.add('error');
          state.textContent = window.siteI18n?.t?.('projects.empty', lang === 'en' ? 'No projects available right now.' : 'لا توجد مشاريع متاحة حاليًا.')
            || (lang === 'en' ? 'No projects available right now.' : 'لا توجد مشاريع متاحة حاليًا.');
          return;
        }

        state.style.display = 'none';
        renderSummary(valid, lang);

        grid.innerHTML = valid.map((project, index) => {
          const safeName = escapeHtml(project.name);
          const safeImage = escapeHtml(project.image);
          const currentAlt = lang === 'en' ? (project.altEn || project.altAr || project.name) : (project.altAr || project.altEn || project.name);
          const currentDesc = lang === 'en' ? (project.descEn || project.descAr || '') : (project.descAr || project.descEn || '');
          const safeAlt = escapeHtml(currentAlt);
          const safeDesc = escapeHtml(currentDesc);
          const parsedTags = splitTags(project.tags).slice(0, 4);
          const stackHtml = (parsedTags.length ? parsedTags : [lang === 'en' ? 'Backend' : 'Back-End'])
            .map((tag) => `<span class="project-tag">${escapeHtml(tag)}</span>`)
            .join('');
          const safeLink = escapeHtml(project.link || '#');
          const hasLink = Boolean(project.link);
          const openLabel = lang === 'en' ? 'View Project' : 'عرض المشروع';
          const contactLabel = lang === 'en' ? 'Contact' : 'تواصل';
          const requestLabel = lang === 'en' ? 'Request Access' : 'اطلب التفاصيل';
          const fallbackDesc = lang === 'en'
            ? 'Scalable software project with production-focused architecture and delivery.'
            : 'مشروع قابل للتوسع مع تنفيذ هندسي يركز على الجاهزية للإنتاج.';

          return `
          <article class="project-card ${index === 0 ? 'featured' : ''}" role="listitem" itemscope itemtype="https://schema.org/SoftwareApplication">
            <div class="project-image ${project.image ? '' : 'is-placeholder'}">
              ${project.image
                ? `<img src="${safeImage}" alt="${safeAlt}" width="640" height="360" loading="lazy" decoding="async" itemprop="image" />`
                : `<span>${lang === 'en' ? 'Project Preview' : 'معاينة المشروع'}</span>`
              }
            </div>
            <div class="project-body">
              <h2 class="project-title" title="${safeName}">
                <span itemprop="name">${safeName}</span>
              </h2>
              <p class="project-desc" itemprop="description">${safeDesc || fallbackDesc}</p>
              <div class="project-stack">${stackHtml}</div>
              <div class="project-actions">
                <a class="project-action primary" href="${hasLink ? safeLink : '/#contact'}" ${hasLink ? 'target="_blank" rel="noopener noreferrer"' : ''} aria-label="${safeName}">
                  <span>${hasLink ? openLabel : requestLabel}</span>
                </a>
                <a class="project-action ghost" href="/#contact" aria-label="${contactLabel}: ${safeName}">
                  <span>${contactLabel}</span>
                </a>
              </div>
            </div>
          </article>`;
        }).join('');
      }

      let sourceProjects = [];

      fetch('/projects.json', { cache: 'no-cache' })
        .then((res) => {
          if (!res.ok) throw new Error('Failed to fetch projects.json');
          return res.json();
        })
        .then((projects) => {
          sourceProjects = (projects || []).map(normalizeProject);
          renderProjects(sourceProjects);
        })
        .catch(() => {
          const state = document.getElementById('projects-state');
          if (state) {
            state.classList.add('error');
            const fallback = document.body.classList.contains('lang-en')
              ? 'Could not load projects data. Please try again later.'
              : 'تعذر تحميل بيانات المشاريع الآن. حاول مرة أخرى لاحقًا.';
            state.textContent = window.siteI18n?.t?.('projects.fetch_error', fallback) || fallback;
          }
        });

      window.addEventListener('site:lang-change', () => {
        if (sourceProjects.length) renderProjects(sourceProjects);
      });
    </script>
  </main>
  <HomeLikeFooter />
</body>
</html>
